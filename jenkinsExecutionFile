pipeline{
    agent any
	    tools {
        // 'JDK_17_HOME' must match the name configured in 'Manage Jenkins > Global Tool Configuration'
        jdk 'JAVA_HOME'
    }
    stages{
        stage('Clean')
        {
            steps{
                 bat 'gradlew.bat clean'
            }
        }
        stage('Execute All Tests')
        {
            parallel{
                stage('Smoke Test')
                {
                    steps{bat 'gradlew.bat smokeTests'}
                }
                stage('Regression Test')
                {
                    steps{bat 'gradlew.bat regressionTests'}
                }
            }
        }
    }
}